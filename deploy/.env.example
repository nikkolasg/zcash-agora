# Copy to .env (never committed). The order of operations is in README.md.
POSTGRES_PASSWORD=
# isoloir keygen log --origin zcash-agora.org/agora   -> the seed (secret) and the verifier key
ISOLOIR_LOG_SEED=
ISOLOIR_LOG_KEY=
# isoloir keygen nostr                                 -> the ingest's secret; its public key goes in ledger.json
ISOLOIR_NOSTR_KEY=
# isoloir keygen nostr, a second one, for the authority's tally posts
ISOLOIR_AUTHORITY_NOSTR_KEY=
# The public mirror repository (git over ssh) and a deploy key with write access
ISOLOIR_MIRROR_GIT=git@github.com:lanterne-labs/zcash-agora-mirror.git
ISOLOIR_MIRROR_SSH_KEY=
# Optional: an Ethereum RPC for the ZKPassport certificate registry roots
ISOLOIR_ETH_RPC=
# The image tag (release.yml publishes ghcr.io/lanterne-labs/isoloir:<tag>)
ISOLOIR_TAG=local
INGEST_HOST=ingest.zcash-agora.org
